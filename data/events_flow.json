  "textPools": {
    "jobDaily": {"_default": ["今日も一日、集中して仕事をした。", "仕事の段取りを見直して、少し早く終わらせられた。", "新しい仕事のやり方を覚えた。"], "_mgr": ["部下の相談にのっていたら、自分の仕事が夜までかかった。", "会議、会議、また会議。自分の仕事が進まない。", "部下が大きな仕事をやりとげた。自分のことのようにうれしい。"], "j_youtuber": ["動画の編集で、気がついたら朝になっていた。", "サムネイルを3パターン作って、どれにするか一日なやんだ。", "コメント欄に「いつも見てます」と書いてあって、元気が出た。", "再生数が伸びなくて、何がダメだったのか考えこんだ。"], "j_entertainer": ["エキストラの仕事で、朝から夕方まで待ちつづけた。", "演技のレッスンで、先生にきびしく注意された。", "オーディションの台本を、何度も声に出して練習した。"], "j_dj": ["朝4時までクラブで回して、昼すぎに起きた。", "新しい曲をさがして、レコード店を何軒もまわった。", "フロアが一番もりあがった瞬間、鳥肌が立った。"], "j_voice_actor": ["スタジオで、ひとことのセリフを20回録りなおした。", "滑舌の練習を毎朝欠かさずやっている。", "アニメのモブの声を3役やった。"], "j_idol": ["朝からダンスレッスン。夜はライブ。体がへとへとだ。", "SNSの更新を一日も休まないようにしている。", "ライブで客席から名前を呼ばれて、うれしかった。"], "j_comedian": ["劇場の出番は2分だけ。それでも全力でやった。", "相方とファミレスで夜中までネタを考えた。", "お客さんが3人しかいないライブで、ネタをやった。"], "j_pro_gamer": ["一日10時間、チームで練習した。", "大会の動画を見て、相手の作戦を研究した。", "配信で視聴者と話しながらゲームをした。"], "j_band": ["スタジオで新曲を朝まで練習した。", "ライブハウスのチケットノルマを、自腹で払った。", "路上ライブで、足を止めて聴いてくれる人がいた。"], "j_novelist": ["一日中書いて、原稿用紙5枚しか進まなかった。", "編集者さんと打ち合わせをして、話の結末を書きなおすことにした。", "取材のために、知らない町を歩いてまわった。"], "j_doctor": ["外来で、一日に60人の患者さんを診た。", "手術が無事に終わって、ご家族に頭を下げられた。", "新しい治療法の論文を、夜おそくまで読んだ。"], "j_nurse": ["夜勤明けで、昼間にぐっすり眠った。", "患者さんに「ありがとう」と手をにぎられた。", "ナースコールが鳴りやまない夜だった。"], "j_teacher_elem": ["クラスの子が、さか上がりができるようになった。", "テストの丸つけを家に持ち帰ってやった。", "休み時間に子どもたちとドッジボールをした。"], "j_teacher_sec": ["部活の練習試合で、休日がつぶれた。", "授業がうまくいって、生徒が目をかがやかせていた。", "進路相談で、生徒の将来の話をじっくり聞いた。"], "j_police": ["交番で、道をたずねられて案内した。", "夜のパトロールで、酔っぱらいのけんかを止めた。", "落とし物の財布が持ち主に戻った。"], "j_firefighter": ["24時間の当番で、出動が3回あった。", "訓練で、はしごを何度ものぼりおりした。", "子どもたちが消防署の見学に来た。"], "j_pilot": ["早朝のフライトで、雲の上から日の出を見た。", "シミュレーター訓練で、緊急着陸の練習をした。", "海外のホテルで時差ぼけと戦った。"], "j_cabin": ["満席のフライトで、機内サービスに走りまわった。", "乗客の子どもに、手作りのカードをもらった。", "ステイ先の街を、少しだけ観光した。"], "j_cpa": ["監査で、会社の帳簿を一日中チェックした。", "決算期で、毎日終電だった。"], "j_tax": ["確定申告の時期で、お客さんの書類が山のようにたまった。", "お客さんの節税の相談にのった。"], "j_lawyer": ["裁判所で、依頼人のために弁論をした。", "分厚い資料を読みこんで、作戦を考えた。"], "j_civil_national": ["国会の答弁の準備で、深夜まで役所に残った。", "新しい法律の文章を、一字一句チェックした。", "大臣への説明で、とても緊張した。"], "j_diplomat": ["外国の大使館の人と、英語で会議をした。", "国際会議の資料を夜おそくまで作った。"], "j_announcer": ["朝のニュース番組のため、午前3時に起きた。", "生放送で、原稿を一字もまちがえずに読めた。", "発声練習を毎日欠かさずやっている。"], "j_consultant": ["お客さんの会社の社長に、改革の提案をした。", "資料のグラフを、夜中に何度も直した。"], "j_ibanker": ["大きな会社の合併の案件で、何日も徹夜に近かった。", "海外のチームとの電話会議が夜中まで続いた。"], "j_care": ["利用者さんと、昔の歌をいっしょに歌った。", "入浴の介助で、腰が痛くなった。", "利用者さんに「あなたが来ると安心する」と言われた。"], "j_nursery": ["お昼寝の時間に、連絡帳を書いた。", "子どもが、はじめて自分でくつをはけた。", "運動会の準備で、かざりを夜まで作った。"], "j_farmer": ["朝早くから畑に出て、草むしりをした。", "今年の野菜は、甘くておいしくできた。", "天気予報をにらみながら、収穫の日を決めた。"], "j_fisher": ["夜明け前に船を出した。", "大漁で、港がにぎわった。"], "j_cook": ["ランチのピークで、厨房は戦場のようだった。", "新しいメニューの試作をした。"], "j_patissier": ["朝4時からケーキの仕込みをした。", "クリスマスの予約が、去年より多かった。"], "j_truck": ["夜の高速道路を、何百キロも走った。", "サービスエリアで仮眠をとった。"], "j_taxi": ["深夜のお客さんを、遠くまで送った。", "観光客に、おすすめのお店を聞かれた。"], "j_it_engineer": ["バグの原因がやっとわかって、思わず声が出た。", "新しいプログラミング言語を勉強した。"], "j_researcher": ["実験がうまくいかず、条件を変えてやりなおした。", "学会で発表をした。"], "j_beautician": ["お客さんに似合う髪型を提案して、喜んでもらえた。", "閉店後に、カットの練習をした。"], "j_family_business": ["お店の売り上げを計算して、ためいきをついた。", "常連さんが、新しいお客さんを連れてきてくれた。"], "j_ceo": ["銀行に、追加の融資をお願いしに行った。", "社員みんなでごはんを食べに行った。"], "j_pro_athlete": ["朝から晩まで、練習とトレーニング。", "試合で、スタンドの応援が力になった。"], "entertain": ["オーディションの結果を、どきどきしながら待った。", "本番前、楽屋で深呼吸をした。"], "creative": ["アイデアが出なくて、一日中なやんだ。", "作品が完成して、ほっとした。"], "office": ["書類の山を、一つずつ片づけた。", "会議の資料を作った。"], "business": ["取引先との打ち合わせが、うまくいった。", "新しいお客さんに、商品を説明した。"], "medical": ["患者さんの回復を見て、この仕事を選んでよかったと思った。"]},
    "facilityDaily": ["レクリエーションで、みんなで風船バレーをした。", "職員さんといっしょに、季節のかざりを作った。", "同じフロアの人とお茶を飲みながら、昔の話をした。", "歌の会で、なつかしい歌をみんなで歌った。", "訪問の床屋さんに、髪を切ってもらった。", "リハビリで、前より少し長く歩けるようになった。", "窓から見える木の葉の色で、季節が変わったのを感じた。", "夕ごはんに好物が出て、うれしかった。", "施設の書道クラブで、お手本を見ながら字を書いた。", "となりの部屋の人と、テレビの話でもりあがった。"],
    "hospitalDaily": ["消灯は夜9時。病院の夜は長く感じる。", "看護師さんが、毎朝体温と血圧を測りにきてくれる。", "病院の食事は薄味だけど、だんだん慣れてきた。", "点滴をしながら、本を読んで過ごした。", "窓から見える景色を、ぼんやりながめた。", "先生の回診で「順調ですね」と言われて、ほっとした。", "リハビリの先生といっしょに、病棟の廊下を歩く練習をした。", "入院してから、家のありがたさがよくわかった。"],
    "babyMilestone": ["はじめて「ママ」と言った。", "つかまり立ちができた。", "公園の砂場で1時間も遊んだ。", "ひらがなが少し読めるようになった。", "補助輪なしで自転車に乗れた。"],
    "studentDaily": ["テスト前日、一夜づけをした。", "給食のカレーをおかわりした。", "席がえで、仲のいい友だちと近くになった。", "部活の帰りに友だちとアイスを食べた。", "雨の日の体育は体育館でドッジボール。", "定期テストの結果が返ってきた。"],
    "adultDaily": ["休日は家でゆっくり過ごした。", "久しぶりに地元の友だちと飲みに行った。", "新しいスマホに買いかえた。", "職場の後輩に仕事を教えた。", "健康のために、エレベーターでなく階段を使っている。", "仕事帰りに同僚とごはんを食べた。", "近所のスーパーの特売で、まとめ買いをした。"],
