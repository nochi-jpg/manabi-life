{
  "_comment": "流れるだけイベント（選択肢なし）。枠が空いたときに重み付きで1〜2本流す。hint=才能のヒント（才能の値は出さず、出来事で伝える）。family/lifecycle は人物データから自動で起こる必須の出来事（不変条件の要）。",
  "events": [

    { "id": "ev_f_sibling_birth", "kind": "flow", "emoji": "👶", "cat": "family", "type": "scheduled",
      "when": { "person": [ { "role": "mother", "alive": true, "ageMax": 45 }, { "role": "father", "alive": true } ] },
      "text": "{siblingRelation}が生まれた！{name}は{olderTitle}になった。",
      "effects": { "person": { "add": "sibling" }, "stats": { "happiness": 4 } } },

    { "id": "ev_f_grandparent_death", "kind": "flow", "emoji": "🕯️", "cat": "family",
      "when": { "person": { "role": "grandparent", "alive": true } },
      "risk": "death_byPerson",
      "text": "{personName}が亡くなった。{funeralText}",
      "effects": { "person": { "kill": "$who" }, "stats": { "happiness": -4 } } },

    { "id": "ev_f_parent_death", "kind": "flow", "emoji": "🕯️", "cat": "family",
      "when": { "person": { "role": "father|mother", "alive": true } },
      "risk": "death_byPerson",
      "text": "{personName}が{personAge}歳で亡くなった。{funeralText}",
      "effects": { "person": { "kill": "$who" }, "stats": { "happiness": -10, "stress": 8 }, "clearIfCareTarget": ["caregiving"], "schedule": [ { "event": "ev_f_inheritance", "inYears": [0, 0], "ifAdult": true } ], "childOrphanCheck": true },
      "note": "未成年でひとり親が亡くなった場合は、親せきに引き取られる（engine: guardian）。遺族年金を自動付与" },

    { "id": "ev_f_inheritance", "kind": "flow", "emoji": "📜", "cat": "family", "type": "scheduled",
      "when": { "age": [18, 105] },
      "text": "{inheritText}",
      "effects": { "inheritance": "$estate", "setIfPositive": ["inheritance"] },
      "note": "遺産 = 親の資産 − 借金 を きょうだい人数で分ける。マイナスなら相続放棄を自動で選ぶ（借金は引き継がない）" },

    { "id": "ev_f_spouse_death", "kind": "flow", "emoji": "🕊️", "cat": "family",
      "when": { "all": ["married"], "person": { "role": "spouse", "alive": true } },
      "risk": "death_byPerson",
      "text": "{spouse}が{personAge}歳で亡くなった。長い間、ありがとう。",
      "effects": { "person": { "kill": "spouse" }, "clear": ["married"], "set": ["widowed"], "stats": { "happiness": -15, "stress": 12, "social": -6 }, "survivorPension": true } },

    { "id": "ev_f_childbirth", "kind": "flow", "emoji": "👶", "cat": "family", "type": "scheduled",
      "when": { "all": ["pregnant"] },
      "text": "{year}年{month}月、{child}が生まれた！",
      "effects": { "person": { "add": "child" }, "stats": { "happiness": 12, "stress": 5 }, "childAllowance": true, "afterBirth": true },
      "note": "妊娠（pregnant）から約10か月後（3季節後）に予約される。妊娠中に別れても、子どもは生まれる" },

    { "id": "ev_f_child_entry", "kind": "flow", "emoji": "🎒", "cat": "family",
      "when": { "child": { "age": [6, 6], "alive": true } },
      "text": "{child}が小学校に入学した。ランドセル姿がまぶしい。",
      "effects": { "stats": { "happiness": 4 }, "childCostStage": "elem" } },

    { "id": "ev_f_child_jhs", "kind": "flow", "emoji": "🧑‍🎓", "cat": "family",
      "when": { "child": { "age": [12, 12], "alive": true } },
      "text": "{child}が中学生になった。最近、あまり話してくれない。",
      "effects": { "childCostStage": "jhs", "personRelation": { "child": -2 } } },

    { "id": "ev_f_child_hs", "kind": "flow", "emoji": "🏫", "cat": "family",
      "when": { "child": { "age": [15, 15], "alive": true } },
      "text": "{child}が{childSchool}に進学した。",
      "effects": { "childCostStage": "hs" } },

    { "id": "ev_f_child_after_hs", "kind": "flow", "emoji": "🧭", "cat": "family",
      "when": { "child": { "age": [18, 18], "alive": true } },
      "text": "{child}は{childPath}。",
      "effects": { "childCostStage": "$childPath" } },

    { "id": "ev_f_child_work", "kind": "flow", "emoji": "💼", "cat": "family",
      "when": { "child": { "age": [18, 26], "alive": true, "stage": ["work_start"] } },
      "text": "{child}が{childJob}として働き始めた。学費の支払いが終わった。",
      "effects": { "childCostStage": "none", "stats": { "happiness": 5 } } },

    { "id": "ev_f_child_marry", "kind": "flow", "emoji": "💒", "cat": "family",
      "when": { "child": { "age": [22, 45], "alive": true, "married": false } },
      "roll": { "ageCurve": { "24": 0.04, "27": 0.08, "30": 0.1, "33": 0.08, "36": 0.05, "40": 0.02, "45": 0.005 }, "of": "childAge" },
      "success": { "text": "💒 {child}が結婚した！", "effects": { "childSet": { "married": true }, "stats": { "happiness": 6 }, "cash": -50 } },
      "fail": { "text": "", "effects": { "silent": true } } },

    { "id": "ev_f_grandchild", "kind": "flow", "emoji": "👼", "cat": "family",
      "when": { "child": { "alive": true, "married": true, "birthParentAge": [20, 45] } },
      "roll": { "ageCurve": { "25": 0.15, "30": 0.15, "35": 0.1, "40": 0.04, "45": 0.005 }, "of": "childBirthParentAge" },
      "success": { "text": "👼 {child}に子どもが生まれた。{name}は{grandTitle}になった！", "effects": { "person": { "add": "grandchild", "parentFrom": "$matchedChild" }, "stats": { "happiness": 10 } } },
      "fail": { "text": "", "effects": { "silent": true } },
      "note": "I-1：結婚している子がいないと条件を満たさない。孫は必ずその子の id を parentIds に持つ" },

    { "id": "ev_f_child_death", "kind": "flow", "emoji": "🕯️", "cat": "family",
      "when": { "child": { "alive": true } },
      "risk": "death_byPerson",
      "text": "{child}が亡くなった。親より先に……。",
      "effects": { "person": { "kill": "$who" }, "stats": { "happiness": -25, "stress": 20 } } },

    { "id": "ev_f_cash_negative", "kind": "flow", "emoji": "🟥", "cat": "money",
      "when": { "age": [16, 105], "money": { "cash": ["<", 0] }, "once": true },
      "text": "所持金がマイナスになった。足りない分は、カードローンで借りていることになる。借りたお金には毎年15%の利息がつき、放っておくとどんどん増えていく。",
      "effects": { "set": ["debt_card"], "stats": { "stress": 5 } } },
    { "id": "ev_f_cash_recover", "kind": "flow", "emoji": "🟩", "cat": "money",
      "when": { "all": ["debt_card"], "money": { "cash": [">=", 0] } },
      "text": "やっと所持金がプラスにもどった。借金を返し終えた。",
      "effects": { "clear": ["debt_card"], "stats": { "stress": -6, "happiness": 4 } } },
    { "id": "ev_f_scholar_done", "kind": "flow", "emoji": "🎉", "cat": "money",
      "when": { "all": ["scholarship_loan_repaying"], "repayFinished": true },
      "text": "奨学金を{repayYears}年かけて、ついに返し終わった！ 借りていた{scholarBorrowed}万円を、すべて返した。",
      "effects": { "clear": ["scholarship_loan_repaying"], "stats": { "happiness": 6, "stress": -4 } } },

    { "id": "ev_f_danshin", "kind": "flow", "emoji": "🛡️", "cat": "money",
      "when": { "all": ["widowed", "mortgage"], "var": { "mortgageBorrower": ["spouse"] }, "once": true },
      "text": "住宅ローンは亡くなった{spouse}の名前で借りていた。団体信用生命保険で、残りのローン{loanLeft}万円がなくなった。",
      "effects": { "clear": ["mortgage"], "loanClose": "mortgage" } },
    { "id": "ev_f_mortgage_done", "kind": "flow", "emoji": "🎉", "cat": "money",
      "when": { "all": ["mortgage"], "loanFinished": "mortgage" },
      "text": "住宅ローンを返し終わった！ 家は完全に自分たちのものになった。",
      "effects": { "clear": ["mortgage"], "stats": { "happiness": 8, "stress": -6 } } },

    { "id": "ev_f_pet_death", "kind": "flow", "emoji": "🌈", "cat": "life", "type": "scheduled",
      "when": { "all": ["pet"] },
      "text": "長い間いっしょだったペットが、虹の橋をわたった。",
      "effects": { "clear": ["pet"], "stats": { "happiness": -6 } } },

    { "id": "ev_f_return_japan", "kind": "flow", "emoji": "🛬", "cat": "work", "type": "scheduled",
      "when": { "all": ["lives_abroad", "transfer_abroad"] },
      "text": "海外赴任を終えて日本に帰ってきた。",
      "effects": { "clear": ["lives_abroad"], "incomeMul": 0.77, "promotionBonus": 0.1 } },

    { "id": "ev_f_recover_depression", "kind": "flow", "emoji": "🌤️", "cat": "health", "type": "scheduled",
      "when": { "all": ["dz_depression"] },
      "text": "少しずつ、朝起きるのがつらくなくなってきた。回復に向かっている。",
      "effects": { "clear": ["dz_depression"], "stats": { "stress": -10, "happiness": 6 }, "job": { "returnFromLeave": true } } },

    { "id": "ev_f_hint_art_hi", "kind": "flow", "emoji": "🎨", "cat": "hint",
      "when": { "age": [3, 12], "talent": { "t_art": [">=", 65] }, "once": true }, "weight": { "base": 3 },
      "text": "幼稚園の先生に「絵の色づかいがすてきね」とほめられた。" },
    { "id": "ev_f_hint_art_lo", "kind": "flow", "emoji": "✏️", "cat": "hint",
      "when": { "age": [5, 12], "talent": { "t_art": ["<", 35] }, "once": true }, "weight": { "base": 2 },
      "text": "図工の作品、思ったとおりの形にならなくてくやしかった。" },
    { "id": "ev_f_hint_math_hi", "kind": "flow", "emoji": "🧮", "cat": "hint",
      "when": { "age": [4, 12], "talent": { "t_academic": [">=", 65] }, "once": true }, "weight": { "base": 3 },
      "text": "買い物のとき、おつりを暗算してお母さんをびっくりさせた。" },
    { "id": "ev_f_hint_book_hi", "kind": "flow", "emoji": "📖", "cat": "hint",
      "when": { "age": [5, 12], "talent": { "t_academic": [">=", 60] }, "var": { "like6": ["like_book"] }, "once": true }, "weight": { "base": 3 },
      "text": "図書室の本を1年で100冊読んで、表彰された。" },
    { "id": "ev_f_hint_study_lo", "kind": "flow", "emoji": "😵", "cat": "hint",
      "when": { "age": [7, 12], "talent": { "t_academic": ["<", 35] }, "once": true }, "weight": { "base": 2 },
      "text": "九九がなかなか覚えられなくて、居残りになった。" },
    { "id": "ev_f_hint_sport_hi", "kind": "flow", "emoji": "🏃", "cat": "hint",
      "when": { "season": ["Q1", "Q3"], "age": [4, 12], "talent": { "t_sport": [">=", 65] }, "once": true }, "weight": { "base": 3 },
      "text": "運動会のかけっこで1位！「足が速いね」とみんなに言われた。" },
    { "id": "ev_f_hint_sport_lo", "kind": "flow", "emoji": "🤸", "cat": "hint",
      "when": { "age": [6, 12], "talent": { "t_sport": ["<", 35] }, "once": true }, "weight": { "base": 2 },
      "text": "逆上がりの練習、今日もできなかった。" },
    { "id": "ev_f_hint_comm_hi", "kind": "flow", "emoji": "🧑‍🤝‍🧑", "cat": "hint",
      "when": { "age": [3, 12], "talent": { "t_comm": [">=", 65] }, "once": true }, "weight": { "base": 3 },
      "text": "転校生にいちばんに話しかけたのは{name}だった。すぐに仲良くなった。" },
    { "id": "ev_f_hint_comm_lo", "kind": "flow", "emoji": "🫥", "cat": "hint",
      "when": { "age": [4, 12], "talent": { "t_comm": ["<", 35] }, "once": true }, "weight": { "base": 2 },
      "text": "休み時間、みんなの輪に入るタイミングがわからなかった。" },
    { "id": "ev_f_hint_health_hi", "kind": "flow", "emoji": "💪", "cat": "hint",
      "when": { "age": [6, 12], "talent": { "t_health": [">=", 65] }, "once": true }, "weight": { "base": 3 },
      "text": "今年も1日も休まず、皆勤賞をもらった。" },
    { "id": "ev_f_hint_health_lo", "kind": "flow", "emoji": "🤧", "cat": "hint",
      "when": { "age": [1, 12], "talent": { "t_health": ["<", 35] }, "once": true }, "weight": { "base": 3 },
      "text": "季節の変わり目になると、すぐ熱を出してしまう。" },
    { "id": "ev_f_hint_music_hi", "kind": "flow", "emoji": "🎵", "cat": "hint",
      "when": { "age": [4, 12], "talent": { "t_music": [">=", 68] }, "club": ["ls_piano", "ls_dance", "ls_violin", "ls_chorus"], "once": true }, "weight": { "base": 3 },
      "text": "一度聞いただけの曲を、すぐに口ずさめた。先生が目を丸くしていた。" },
    { "id": "ev_f_hint_looks", "kind": "flow", "emoji": "✨", "cat": "hint",
      "when": { "season": ["Q3"], "age": [13, 18], "talent": { "looks": [">=", 70] }, "once": true }, "weight": { "base": 2 },
      "text": "文化祭のあと、知らない学年の人から声をかけられた。" },
    { "id": "ev_f_hint_like_gap", "kind": "flow", "emoji": "🤔", "cat": "hint",
      "when": { "age": [8, 14], "likeTalentGap": true, "once": true }, "weight": { "base": 3 },
      "text": "好きなのに、なかなか上手くならない。でも、やっぱり好きだ。" },

    { "id": "ev_f_school_trip", "kind": "flow", "emoji": "🚅", "cat": "school",
      "when": { "season": ["Q1", "Q3"], "stage": ["elem", "jhs", "hs"], "schoolTripYear": true },
      "text": "修学旅行で{tripDest}へ。{tripMemory}",
      "effects": { "stats": { "social": 3, "happiness": 4 } } },
    { "id": "ev_f_sports_day", "kind": "flow", "emoji": "🏁", "cat": "school",
      "when": { "season": ["Q1", "Q3"], "stage": ["elem", "jhs"], "cooldownYears": 1 }, "weight": { "base": 2 },
      "text": "運動会。{sportsDayResult}" },
    { "id": "ev_f_culture_fest", "kind": "flow", "emoji": "🎪", "cat": "school",
      "when": { "season": ["Q3"], "stage": ["jhs", "hs", "univ"], "cooldownYears": 1 }, "weight": { "base": 2 },
      "text": "文化祭でクラスの出し物をした。{festMemory}", "effects": { "stats": { "social": 2 } } },
    { "id": "ev_f_summer_homework", "kind": "flow", "emoji": "🌻", "cat": "school",
      "when": { "season": ["Q2"], "stage": ["elem"], "cooldownYears": 1 }, "weight": { "base": 2 },
      "text": "夏休みの宿題、{homeworkResult}" },
    { "id": "ev_f_otoshidama", "kind": "flow", "emoji": "🧧", "cat": "life",
      "when": { "season": ["Q4"], "age": [3, 18], "cooldownYears": 1 }, "weight": { "base": 2 },
      "text": "お年玉を{otoshidama}円もらった。", "effects": { "cash_child": "$otoshidama" } },
    { "id": "ev_f_valentine", "kind": "flow", "emoji": "🍫", "cat": "love",
      "when": { "season": ["Q4"], "age": [10, 18], "cooldownYears": 2 }, "weight": { "base": 1 },
      "text": "{valentineText}" },
    { "id": "ev_f_family_trip", "kind": "flow", "emoji": "🏖️", "cat": "family",
      "when": { "season": ["Q2"], "age": [3, 15], "talent": { "familyWealth": [">=", 40] }, "cooldownYears": 2 }, "weight": { "base": 2 },
      "text": "家族で{tripPlace}に旅行した。", "effects": { "stats": { "happiness": 4 } } },
    { "id": "ev_f_no_trip", "kind": "flow", "emoji": "🏠", "cat": "family",
      "when": { "season": ["Q2"], "age": [6, 15], "talent": { "familyWealth": ["<", 25] }, "cooldownYears": 3 }, "weight": { "base": 2 },
      "text": "夏休み、友だちは旅行の話をしていた。うちはどこにも行かなかった。", "effects": { "stats": { "happiness": -1 } } },
    { "id": "ev_f_parent_overtime", "kind": "flow", "emoji": "🌙", "cat": "family",
      "when": { "age": [3, 12], "person": { "role": "father|mother", "alive": true, "jobOvertimeMin": 40 }, "cooldownYears": 3 }, "weight": { "base": 2 },
      "text": "{parentName}は今日も帰りが遅い。夕ごはんはひとりで食べた。", "effects": { "stats": { "happiness": -1 } } },
    { "id": "ev_f_grandparent_live", "kind": "flow", "emoji": "👵", "cat": "family",
      "when": { "age": [3, 12], "person": { "role": "grandparent", "alive": true, "livesTogether": true }, "cooldownYears": 3 }, "weight": { "base": 2 },
      "text": "おばあちゃんに、昔の{pref}の話を聞いた。", "effects": { "stats": { "happiness": 2, "social": 1 } } },
    { "id": "ev_f_snow", "kind": "flow", "emoji": "⛄", "cat": "life",
      "when": { "season": ["Q4"], "climate": ["snow"], "cooldownYears": 2 }, "weight": { "base": 2 },
      "text": "今年は大雪。{snowText}" },
    { "id": "ev_f_typhoon", "kind": "flow", "emoji": "🌀", "cat": "life",
      "when": { "season": ["Q2"], "climate": ["warm", "subtropical"], "cooldownYears": 2 }, "weight": { "base": 2 },
      "text": "大きな台風が来て、学校や仕事が休みになった。" },

    { "id": "ev_f_first_salary", "kind": "flow", "emoji": "💴", "cat": "work",
      "when": { "jobYears": [0, 0], "season": ["Q2"], "employment": ["seishain", "civil_servant", "keiyaku"], "once": true },
      "text": "初めてのボーナス。{firstBonusUse}", "effects": { "stats": { "happiness": 4 } } },
    { "id": "ev_f_bonus", "kind": "flow", "emoji": "💰", "cat": "work",
      "when": { "season": ["Q2", "Q4"], "employment": ["seishain", "civil_servant"] }, "weight": { "base": 1 },
      "text": "{bonusText}", "effects": { "silentIfSmall": true } },
    { "id": "ev_f_ai_at_work", "kind": "flow", "emoji": "🤖", "cat": "work",
      "when": { "employment": ["seishain", "keiyaku", "haken", "civil_servant"], "jobCat": ["office", "finance", "it", "writing"], "once": true }, "weight": { "base": 2 },
      "text": "職場に新しいAIツールが入った。仕事のやり方が大きく変わりそうだ。", "effects": { "skill": { "it": 2 } } },
    { "id": "ev_f_inflation", "kind": "flow", "emoji": "🛒", "cat": "money",
      "when": { "age": [16, 105], "cooldownYears": 6 }, "weight": { "base": 1 },
      "text": "物の値段がまた上がった。スーパーのレシートを見てため息。", "effects": { "livingCostMul": 1.03 } },
    { "id": "ev_f_tax_return", "kind": "flow", "emoji": "🧾", "cat": "money",
      "when": { "season": ["Q4"], "employment": ["freelance", "self_employed", "executive"] },
      "text": "確定申告の季節。1年分のレシートと格闘した。" },
    { "id": "ev_f_wedding_anniv", "kind": "flow", "emoji": "💐", "cat": "family",
      "when": { "all": ["married"], "marriedYearsIn": [10, 25, 50] },
      "text": "{spouse}と結婚{marriedYears}周年。{anniversaryText}", "effects": { "person": { "relation": "spouse", "delta": 3 } } },
    { "id": "ev_f_promotion_peer", "kind": "flow", "emoji": "😶", "cat": "work",
      "when": { "employment": ["seishain"], "age": [30, 50], "counter": { "promotion_level": ["<", 2] }, "cooldownYears": 5 }, "weight": { "base": 1 },
      "text": "同期が先に課長になった。", "effects": { "stats": { "happiness": -2, "stress": 2 } } },
    { "id": "ev_f_commute", "kind": "flow", "emoji": "🚃", "cat": "life",
      "when": { "region": ["A"], "employment": ["seishain", "keiyaku", "haken"], "cooldownYears": 4 }, "weight": { "base": 1 },
      "text": "満員電車で片道1時間。毎日のことだけど、なかなか慣れない。", "effects": { "stats": { "stress": 1 } } },
    { "id": "ev_f_rural_car", "kind": "flow", "emoji": "🛣️", "cat": "life",
      "when": { "ruralMin": 0.8, "none": ["owns_car"], "age": [18, 75], "cooldownYears": 3 }, "weight": { "base": 1.5 },
      "text": "バスは1時間に1本。車がないと、どこに行くにも不便だ。", "effects": { "stats": { "stress": 1, "social": -1 } } },

    { "id": "ev_f_reading_glasses", "kind": "flow", "emoji": "👓", "cat": "health",
      "when": { "age": [43, 50], "once": true },
      "text": "スマホの文字が読みにくい……老眼が始まったらしい。" },
    { "id": "ev_f_back_pain", "kind": "flow", "emoji": "🦴", "cat": "health",
      "when": { "age": [40, 90], "physicalLoadMin": 60, "cooldownYears": 5 }, "weight": { "base": 2 },
      "text": "腰が痛くて、朝起き上がるのがつらい。", "effects": { "stats": { "health": -2 } } },
