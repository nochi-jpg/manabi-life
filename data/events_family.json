    {"id": "ev_m_job_hunt_license", "kind": "choice", "emoji": "👔", "cat": "work", "type": "scheduled", "counselor": "self", "when": {"none": ["naitei"]}, "text": "国家試験に合格！資格を生かして働く場所をさがそう。", "fact": {"text": "看護師・美容師・薬剤師などの国家資格は、試験に合格してはじめて、その仕事につくことができます。", "src": "厚生労働省"}, "choices": [{"menu": {"source": "jobs.jobs", "page": 5, "showRate": true, "filter": "eligible"}, "roll": {"rate": "$menuRate"}, "success": {"set": ["naitei"], "var": {"target": "$pick"}, "stats": {"happiness": 8}, "log": "🌸 {target}に採用が決まった！"}, "fail": {"stats": {"stress": 4}, "schedule": [{"event": "ev_r_job_search", "inYears": [0, 0]}], "log": "🍂 不採用。卒業してからもう一度さがす。"}}]},

