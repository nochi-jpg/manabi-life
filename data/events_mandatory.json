      "text": "社会人1年目。{job}として働き始めた。初任給は{income}万円。",
      "effects": { "job": { "hire": "$target" }, "clear": ["naitei"], "scholarRepayStartIfLoan": true, "log": "🏢 {job}として就職" }
    },
    {
      "id": "ev_m_housing", "kind": "choice", "emoji": "🏠", "counselor": "self",
      "when": { "season": ["Q1"], "jobYears": [0, 0], "employment": ["seishain", "civil_servant", "keiyaku", "haken", "part", "freelance"], "stage": ["none"], "none": ["owns_house"], "once": true },
      "text": "社会人になった。どこに住む？（{pref}の家賃のめやす：ひとり用 月{rentSingle}万円）",
      "choices": [
        { "label": "🏠 実家から通う（家に月3万円入れる）", "when": { "person": { "role": "father|mother", "alive": true }, "var": { "workAway": [false] } }, "effects": { "set": ["lives_with_parents"], "clear": ["living_alone", "renting"], "rentMonthly": 3, "stats": { "happiness": 1 } } },
        { "label": "🔑 部屋を借りてひとり暮らし（月{rentSingle}万円・最初に家賃の4か月分）", "effects": { "set": ["living_alone", "renting"], "clear": ["lives_with_parents"], "rentMonthly": "$rentSingle", "cash": "-$moveInCost", "stats": { "happiness": 4, "social": -2 } } },
        { "label": "🏢 会社の寮・社宅に入る（相場の3割くらい）", "when": { "companyHousing": true }, "effects": { "set": ["company_housing", "renting"], "clear": ["lives_with_parents"], "rentMonthly": "$rentCompany", "stats": { "social": 2 } } },
        { "label": "🏘️ シェアハウスに住む（月{rentShare}万円）", "when": { "region": ["A"] }, "effects": { "set": ["living_alone", "renting"], "clear": ["lives_with_parents"], "rentMonthly": "$rentShare", "stats": { "social": 3 } } }
      ],
      "note": "workAway＝勤め先が実家から通えないとき true（転勤・上京など）"
    },
    {
      "id": "ev_m_scholar_repay", "kind": "flow", "emoji": "📄",
      "when": { "season": ["Q2"], "all": ["scholarship_loan"], "none": ["scholarship_loan_repaying"], "stage": ["none"], "once": true },
      "text": "奨学金の返済が始まった。毎月{repay}万円、{repayYears}年間。",
      "effects": { "scholarStart": true, "set": ["scholarship_loan_repaying"], "clear": ["scholarship_loan"] }
    },
    {
      "id": "ev_m_job_review", "kind": "choice", "emoji": "🔄", "counselor": "self",
      "when": { "season": ["Q1"], "jobYears": [5, 10, 15, 20, 25, 30], "employment": ["seishain", "keiyaku", "civil_servant", "freelance", "self_employed"], "age": [22, 59] },
      "text": "今の仕事について{jobYears}年。給料{income}万円、満足感{jobSat}。このままでいい？",
      "choices": [
        { "label": "🙂 今の仕事を続ける", "effects": { "stats": { "happiness": 1 } } },
        { "label": "🔄 転職活動をする", "menu": { "source": "jobs.midCareer", "page": 5, "showRate": true, "filter": "eligible" }, "roll": { "rate": "$menuRate" }, "success": { "job": { "hire": "$pick" }, "counter": { "job_changes": 1 }, "log": "🔄 {pick}に転職" }, "fail": { "stats": { "stress": 3 }, "log": "🍂 転職活動はうまくいかなかった" } },
        { "label": "📖 資格をとって仕事を変える", "effects": { "focus": "focus_qualify", "schedule": [ { "event": "ev_r_qualify", "inYears": [0, 1] } ] } },
        { "label": "🚀 独立・起業する", "when": { "money": { "cash": [">=", 100] } }, "effects": { "schedule": [ { "event": "ev_r_startup", "inYears": [0, 0] } ] } },
        { "label": "🧺 仕事をゆるめる（パート・アルバイトに）", "effects": { "job": { "form": "part" }, "stats": { "stress": -10, "happiness": 2 } } },
        { "label": "😌 一度やめて休む", "effects": { "job": { "quit": "self" }, "stats": { "stress": -15 }, "set": ["unemployment_exp"] } }
      ]
    },
    {
      "id": "ev_m_promotion", "kind": "flow", "emoji": "📈",
      "when": { "season": ["Q1"], "employment": ["seishain", "civil_servant", "part"], "hasRankTrack": true, "nextStepExam": false, "nextStepYearsMet": true },
      "roll": { "rate": "$nextStepRate", "w": "ranks.rules.rollWeights", "focusBonus": { "focus_work": 0.15, "focus_family": -0.1 } },
      "success": { "text": "📈 {jobLabel}として{newTitle}になった！", "effects": { "rankUp": true, "counter": { "promotion_level": 1 }, "stats": { "happiness": 4 }, "log": "📈 {newTitle}に昇進" } },
      "fail": { "text": "", "effects": { "silent": true } },
      "note": "昇進先は data/ranks.json の track で決まる。教師に課長はなく、警察は巡査→巡査部長…。mgr の段になったら manager フラグ"
    },
    {
      "id": "ev_m_promotion_exam", "kind": "choice", "emoji": "📝", "counselor": "self",
      "when": { "season": ["Q2"], "employment": ["seishain", "civil_servant"], "hasRankTrack": true, "nextStepExam": true, "nextStepYearsMet": true, "cooldownYears": 1 },
      "text": "{nextTitle}になるための{examName}を受けることができる。受かれば給料は上がるが、責任も重くなる。",
      "choices": [
        { "label": "📝 試験を受ける", "showRate": true, "roll": { "rate": "$nextStepRate", "w": "ranks.rules.examWeights" }, "success": { "rankUp": true, "counter": { "promotion_level": 1 }, "stats": { "happiness": 5, "stress": 3 }, "log": "📝 試験に合格し、{newTitle}になった" }, "fail": { "stats": { "happiness": -2 }, "log": "🍂 {examName}は不合格。来年また受けられる" } },
        { "label": "🙂 今の立場で、目の前の仕事を続けたい", "effects": { "stats": { "stress": -2 }, "var": { "declinedExam": "+1" } } }
      ]
    },
    {
      "id": "ev_m_contract_end", "kind": "choice", "emoji": "📄", "counselor": "self",
      "when": { "season": ["Q4"], "employment": ["keiyaku", "haken"], "contractEnd": true },
      "text": "契約期間が終わる。どうなる？",
      "choices": [
        { "label": "🙏 正社員にしてもらえないか相談する", "showRate": true, "roll": { "base": 0.25, "w": { "t_comm": 0.3, "social": 0.2 } }, "success": { "job": { "form": "seishain" }, "stats": { "happiness": 8 }, "log": "🌸 正社員に登用された！" }, "fail": { "job": { "quit": "fired" }, "set": ["unemployment_exp"], "log": "🍂 契約終了。次の仕事を探す" } },
        { "label": "🔄 別の会社で正社員をめざす", "menu": { "source": "jobs.midCareer", "page": 5, "showRate": true, "filter": "eligible" }, "roll": { "rate": "$menuRate" }, "success": { "job": { "hire": "$pick", "form": "seishain" } }, "fail": { "job": { "form": "haken" } } },
        { "label": "📄 同じ形で更新する", "effects": { "renewContract": true } }
      ]
    },
    {
      "id": "ev_m_unemployed", "kind": "choice", "emoji": "🔍", "counselor": "self",
      "when": { "season": ["Q1", "Q3"], "employment": ["unemployed", "none"], "stage": ["none"], "age": [18, 64], "none": ["welfare"] },
      "text": "今は仕事がない。（失業手当：{benefitLeft}）どうする？",
      "choices": [
        { "label": "🔍 ハローワークで仕事を探す", "menu": { "source": "jobs.midCareer", "page": 5, "showRate": true, "filter": "eligible" }, "roll": { "rate": "$menuRate" }, "success": { "job": { "hire": "$pick" } }, "fail": { "stats": { "stress": 5 } } },
        { "label": "🧺 まずはアルバイトで働く", "effects": { "job": { "hire": "j_parttime_general" } } },
        { "label": "🏫 職業訓練校で技術を身につける（無料・半年）", "effects": { "skill": { "it": 10, "craft": 10 }, "schedule": [ { "event": "ev_r_qualify", "inYears": [0, 1] } ] } },
        { "label": "😌 もう少し休む", "effects": { "stats": { "stress": -6, "happiness": -2 } } }
      ]
    },
    {
      "id": "ev_m_child_plan", "kind": "choice", "emoji": "👶", "counselor": "spouse",
      "when": { "season": ["Q1"], "all": ["married"], "none": ["no_children_choice", "wants_children"], "person": { "role": "spouse", "alive": true, "fertile": true }, "marriedYears": [1, 1] },
      "text": "結婚して1年。{spouse}と子どものことを話し合った。",
      "choices": [
        { "label": "👶 子どもがほしい", "effects": { "set": ["wants_children"] } },
        { "label": "⏳ もう少し2人で過ごしたい", "effects": { "schedule": [ { "event": "ev_m_child_plan2", "inYears": [2, 3] } ] } },
        { "label": "🙅 子どもは持たない", "effects": { "set": ["no_children_choice"] } }
      ]
    },
    {
      "id": "ev_m_child_plan2", "kind": "choice", "emoji": "👶", "type": "scheduled", "counselor": "spouse",
      "when": { "all": ["married"], "none": ["no_children_choice", "wants_children"], "person": { "role": "spouse", "alive": true, "fertile": true } },
      "text": "もう一度、子どものことを話し合った。",
      "choices": [
        { "label": "👶 子どもがほしい", "effects": { "set": ["wants_children"] } },
        { "label": "🙅 子どもは持たない", "effects": { "set": ["no_children_choice"] } }
      ]
    },
    {
      "id": "ev_m_retire_age", "kind": "choice", "emoji": "🎉", "counselor": "self",
      "when": { "age": [60, 60], "season": ["Q4"], "employment": ["seishain", "civil_servant"], "once": true },
      "text": "60歳。定年を迎えた。退職金は{severance}万円。この先どうする？",
      "choices": [
        { "label": "🏢 同じ会社で再雇用（65歳まで・給料は約6割）", "effects": { "set": ["reemployed", "retired_flag"], "job": { "reemploy": true }, "cash": "$severance" } },
        { "label": "🔄 別の仕事を探す", "effects": { "set": ["retired_flag"], "job": { "quit": "retire" }, "cash": "$severance", "schedule": [ { "event": "ev_r_senior_job", "inYears": [0, 0] } ] } },
        { "label": "🌴 完全に引退する", "effects": { "set": ["retired_flag"], "job": { "retire": true }, "cash": "$severance", "stats": { "stress": -15, "social": -5 } } }
      ]
    },
    {
      "id": "ev_m_reemploy_end", "kind": "flow", "emoji": "🌴",
      "when": { "age": [65, 65], "season": ["Q4"], "all": ["reemployed"], "once": true },
      "text": "再雇用の期間が終わり、仕事を引退した。おつかれさまでした。",
      "effects": { "job": { "retire": true }, "clear": ["reemployed"], "stats": { "stress": -10 } }
    },
    {
      "id": "ev_m_pension", "kind": "choice", "emoji": "💴", "counselor": "self",
      "when": { "age": [64, 64], "season": ["Q4"], "none": ["pension_early"], "once": true },
      "text": "年金をいつから受け取る？（65歳で受け取ると月{pension}万円）",
      "choices": [
        { "label": "💴 65歳から受け取る", "effects": { "var": { "pensionAge": 65 } } },
        { "label": "⏳ 70歳まで待って増やす（月額が約1.4倍）", "effects": { "var": { "pensionAge": 70 }, "set": ["pension_late"] } },
        { "label": "⏳⏳ 75歳まで待つ（月額が約1.8倍）", "effects": { "var": { "pensionAge": 75 }, "set": ["pension_late"] } }
      ]
    },
    {
      "id": "ev_m_pension_early", "kind": "choice", "emoji": "💴", "counselor": "self",
      "when": { "age": [60, 63], "season": ["Q1"], "employment": ["none", "unemployed", "retired", "homemaker"], "money": { "cash": ["<", 200] }, "none": ["pension_early"], "cooldownYears": 2 },
      "text": "仕事がなく貯金が少ない。年金を早めに受け取る？（月額が減る：1か月早めるごとに0.4%減）",
      "choices": [
        { "label": "💴 今から受け取る", "effects": { "set": ["pension_early"], "var": { "pensionAge": "$age" } } },
        { "label": "🙅 まだ待つ", "effects": {} }
      ]
    },
    {
      "id": "ev_m_license_return", "kind": "choice", "emoji": "🚗", "counselor": "family",
      "when": { "age": [75, 100], "season": ["Q1"], "all": ["lic_car"], "none": ["license_returned"], "cooldownYears": 3 },
      "text": "{age}歳。家族から「運転免許、そろそろ返したら？」と言われた。",
      "choices": [
        { "label": "🪪 免許を返納する", "effects": { "set": ["license_returned"], "clear": ["lic_car", "owns_car"], "stats": { "social": -3 } } },
        { "label": "🚗 まだ運転を続ける", "effects": { "stats": { "happiness": 1 }, "riskMul": { "ev_r_car_accident": 1.5 } } }
      ]
    },
    {
      "id": "ev_m_death", "kind": "flow", "emoji": "🕊️",
      "when": { "engine": "death" },
      "text": "{year}年{month}月。{name}は{age}歳で人生を終えた。{deathCause}",
      "effects": { "endGame": true }
    }
  ]
}
